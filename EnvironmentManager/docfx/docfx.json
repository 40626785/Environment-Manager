{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        {
          "src": "../",
          "files": [
            "**/*.csproj",
            "**/*.cs"
          ]
        }
      ],
      "dest": "api",
      "disableGitFeatures": true
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.yml",
          "api/index.md"
        ]
      },
      {
        "files": [
          "**/*.md",
          "toc.yml"
        ],
        "exclude": [
          "obj/**",
          "bin/**",
          "_site/**",
          "y/**"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "template": [
      "default",
      "modern"
    ],
    "output": "_site",
    "globalMetadata": {
      "_appName": "EnvironmentManager",
      "_appTitle": "EnvironmentManager",
      "_enableSearch": true,
      "pdf": true
    },
    "xref": [
      "api/xrefmap.yml"
    ]
  }
}